<script>
/* Intro control: shows the "hello" screen, then reveals the page. Click, tap or Esc skips it. */
(function(){var d=document.documentElement;d.className="js";
try{var t=localStorage.getItem("theme");if(t)d.dataset.theme=t}catch(e){}
function go(){if(d.classList.contains("go"))return;d.classList.add("go");var i=document.getElementById("intro");if(i){i.classList.add("out");setTimeout(function(){i.remove()},900)}}
if(matchMedia("(prefers-reduced-motion: reduce)").matches){d.classList.add("go")}
else{setTimeout(go,3600);addEventListener("DOMContentLoaded",function(){var i=document.getElementById("intro");if(i)i.addEventListener("click",go)});addEventListener("keydown",function(e){if(e.key==="Escape")go()})}
})();
</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Person","name":"Vasanth R","jobTitle":"Aspiring Data Scientist and Data Analyst","email":"mailto:Vasanthoffcl1@gmail.com","telephone":"+91-9345383905","affiliation":{"@type":"CollegeOrUniversity","name":"SRM Institute of Science & Technology, Tiruchirappalli"},"sameAs":["https://github.com/Vasanthoffcl","https://www.instagram.com/itz_vaxz_7"],"knowsAbout":["Python","HTML","MySQL","Data Analytics","Data Science"]}</script>
