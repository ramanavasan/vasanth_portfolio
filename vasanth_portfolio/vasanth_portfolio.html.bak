<link rel="apple-touch-icon" href="apple-touch-icon.png">
<style>/* ===== Editorial monochrome theme. Edit these values to restyle the whole site ===== */
:root{--bg:#F0EEEA;--alt:#E9E6E1;--card:#F8F7F4;--line:#D8D4CD;--text:#050505;--mute:#5E5A54;--ac:#050505;--ink:#fff;--g:#050505;--glow:rgba(0,0,0,.08);--nav:rgba(240,238,234,.9);--r:18px;
  color-scheme:light;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);box-sizing:border-box}
:root[data-theme=dark]{--bg:#121211;--alt:#1A1A18;--card:#1B1B19;--line:#2E2D2A;--text:#F0EEEA;--mute:#A5A097;--ac:#F0EEEA;--ink:#050505;--g:#F0EEEA;--glow:rgba(255,255,255,.06);--nav:rgba(18,18,17,.9);color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 Inter,system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;overflow-x:hidden;transition:background .4s,color .4s}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:60}
a{color:var(--text)}
.wrap{width:min(1120px,100% - 40px);margin-inline:auto}
.skip{position:absolute;left:-999px;top:0;background:var(--text);color:var(--bg);padding:8px 14px;z-index:100}.skip:focus{left:10px}
:focus-visible{outline:2px solid var(--text);outline-offset:3px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.progress{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;height:3px;background:var(--g);transform:scaleX(0);transform-origin:left;z-index:70}

/* Floating nav (appears after you scroll past the hero) */
.nav{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;z-index:50;background:var(--nav);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);transform:translateY(-110%);visibility:hidden;transition:transform .4s,visibility .4s}
.nav.solid{transform:none;visibility:visible}
.nav-in{display:flex;align-items:center;gap:8px;height:64px}
.logo{order:0;margin-right:auto;font-weight:800;font-size:.98rem;letter-spacing:-.01em;color:var(--text);text-decoration:none}
#menu{display:flex;gap:2px}
#menu a{position:relative;color:var(--mute);text-decoration:none;padding:8px 10px;font-size:.88rem;font-weight:600;transition:color .2s}
#menu a::after{content:"";position:absolute;left:10px;right:10px;bottom:2px;height:2px;background:var(--text);transform:scaleX(0);transition:transform .3s}
#menu a:hover,#menu a.on{color:var(--text)}#menu a:hover::after,#menu a.on::after{transform:scaleX(1)}
.theme,.burger{background:none;border:1px solid var(--line);border-radius:10px;width:40px;height:40px;cursor:pointer;color:var(--text);display:grid;place-items:center}
.theme svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.theme .sun{display:none}:root[data-theme=dark] .theme .sun{display:block}:root[data-theme=dark] .theme .moon{display:none}
.burger{display:none;order:5;align-content:center}.burger span{display:block;width:20px;height:2px;background:var(--text);margin:3px 0;transition:.3s}
.burger[aria-expanded=true] span:nth-child(1){transform:translateY(5px) rotate(45deg)}
.burger[aria-expanded=true] span:nth-child(2){opacity:0}
.burger[aria-expanded=true] span:nth-child(3){transform:translateY(-5px) rotate(-45deg)}

/* Buttons */
.btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 24px;border-radius:99px;font:600 .92rem inherit;font-family:inherit;text-decoration:none;cursor:pointer;border:1px solid var(--text);color:var(--text);background:transparent;transition:transform .25s,background .25s,color .25s}
.btn.primary{background:var(--g);color:var(--ink)}
.btn:hover{transform:translateY(-2px)}.btn.ghost:hover{background:var(--text);color:var(--bg)}
.btn.todo{opacity:.5;border-style:dashed;cursor:not-allowed}.btn.todo:hover{transform:none;background:transparent;color:var(--text)}

/* ===== HERO: framed poster. Name = black outside the frame, white inside; photo sits in front ===== */
.hero-page{--k:.7;--H:max(520px,80vh);position:relative;overflow:hidden;background:#F0EEEA;color:#050505;padding-block:max(44px,10vh)}
.hero-stage{position:relative;height:var(--H)}
.frame{position:absolute;top:0;bottom:0;left:calc((1 - var(--k))*50%);width:calc(var(--k)*100%);border-radius:38px;background:#E3E0DB;box-shadow:0 38px 60px -24px rgba(0,0,0,.35);overflow:hidden;isolation:isolate;z-index:1}
.frame::after{content:"";position:absolute;inset:0;border:2px solid #050505;border-radius:inherit;pointer-events:none;z-index:9}
.name{margin:0;font-weight:900}
.name svg{display:block;overflow:visible}
.name text{font:900 300px/1 "Arial Black",Inter,Helvetica,Arial,sans-serif}
.name-out{position:absolute;left:0;right:0;top:calc(var(--H)*.5 - 12.97vw);z-index:0}
.name-out svg{width:100%;height:auto}.name-out text{fill:#050505}
.name-in{position:absolute;inset:0;overflow:hidden;z-index:1}
.name-in svg{position:absolute;top:calc(var(--H)*.5 - 12.97vw);left:calc(-100%*(1 - var(--k))/2/var(--k));width:calc(100%/var(--k));height:auto}.name-in text{fill:#fff}
.cut{position:absolute;bottom:0;inset-inline:0;margin-inline:auto;height:96%;width:auto;max-width:none;z-index:3;filter:grayscale(1) contrast(1.06) drop-shadow(0 0 2px rgba(255,255,255,.55))}
.hero-nav{position:absolute;top:0;left:0;right:0;z-index:5;display:flex;justify-content:space-between;align-items:center;padding:clamp(20px,3.6vh,34px) clamp(22px,4.6%,46px);font-size:.82rem;font-weight:700}
.hero-nav a{color:#050505;text-decoration:none;transition:opacity .2s}.hero-nav a:hover{opacity:.55}
.hero-nav nav{display:flex;gap:clamp(18px,2.6vw,34px)}
.social{position:absolute;left:clamp(22px,4.6%,46px);bottom:clamp(22px,4.4vh,40px);z-index:5;margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:14px;mix-blend-mode:difference}
.social a{display:grid;place-items:center;width:32px;height:32px;color:#fff;transition:transform .25s}.social a:hover{transform:translateY(-3px) scale(1.12)}
.social svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.roles{position:absolute;right:clamp(22px,4.6%,46px);bottom:clamp(22px,4.4vh,40px);z-index:5;margin:0;text-align:right;mix-blend-mode:difference;color:#fff;font:700 clamp(1.05rem,2vw,1.85rem)/1.12 Inter,"Helvetica Neue",Arial,sans-serif;letter-spacing:-.02em}
/* load animation */
.hero-nav,.social,.roles,.cut{animation:rise 1s cubic-bezier(.2,.7,.2,1) both}
.hero-nav{animation-delay:.15s}.cut{animation-delay:.3s;animation-duration:1.2s}.roles{animation-delay:.8s}.social{animation-delay:1s}
.name-in,.name-out{animation:fade 1s ease .5s both}
@keyframes rise{from{opacity:0;translate:0 40px}}@keyframes fade{from{opacity:0}}@keyframes up{from{opacity:0;transform:translateY(26px)}}
.js:not(.go) .hero-nav,.js:not(.go) .social,.js:not(.go) .roles,.js:not(.go) .cut,.js:not(.go) .name-in,.js:not(.go) .name-out{animation:none;opacity:0}
html.js:not(.go){overflow:hidden}

/* Welcome + sections */
.welcome{padding:70px 0 40px}.eyebrow{letter-spacing:.16em;text-transform:uppercase;font-size:.75rem;color:var(--mute);margin:0;font-weight:600}
.hi{font-size:clamp(2rem,5.4vw,3.6rem);line-height:1.08;margin:.2em 0;letter-spacing:-.04em;font-weight:900}.grad{color:inherit}
.role{font-size:1.1rem;font-weight:700;margin:0 0 6px}.typed{margin:0 0 14px;color:var(--mute)}.typed b{color:var(--text)}
.caret{display:inline-block;width:2px;height:1.1em;background:var(--text);vertical-align:-3px;margin-left:2px;animation:blink 1s steps(2) infinite}@keyframes blink{50%{opacity:0}}
.lead{color:var(--mute);max-width:62ch}
.sec{padding:84px 0}.alt{background:var(--alt)}
.title{font-size:clamp(1.8rem,4.4vw,2.8rem);letter-spacing:-.04em;font-weight:900;margin:0 0 38px;display:flex;align-items:baseline;gap:12px}
.title small{color:var(--mute);font-size:.8rem;font-weight:600;letter-spacing:.05em}
.title::after{content:"";height:1px;flex:1;background:var(--line)}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:26px;box-shadow:0 2px 14px rgba(0,0,0,.04);transition:transform .3s,border-color .3s,box-shadow .3s}
.card:hover{transform:translateY(-4px);border-color:var(--text);box-shadow:0 18px 36px rgba(0,0,0,.08)}.card h3{margin:.2em 0 .4em;letter-spacing:-.02em}
.grid{display:grid;gap:22px}
.projects{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}.three{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
/* skills: pure typography */
.skills ul{list-style:none;margin:0;padding:0}
.icon{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--line);color:var(--text);margin-bottom:12px;transition:transform .35s}.card:hover .icon{transform:rotate(-8deg) scale(1.08)}
.icon svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.pcard{display:flex;flex-direction:column}.pcard p{color:var(--mute);flex:1}.pcard .btn{align-self:flex-start;margin-top:8px}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 14px;padding:0;list-style:none}
.tags li,.chip{font-size:.78rem;padding:3px 12px;border-radius:99px;border:1px solid var(--line);color:var(--mute)}
.about{max-width:820px}.about p{color:var(--mute);font-size:1.06rem}.about strong{color:var(--text)}
.facts{display:flex;flex-wrap:wrap;gap:16px;list-style:none;padding:0;margin:28px 0 0}
.facts li{flex:1 1 150px;border:1px solid var(--line);border-radius:14px;padding:16px;text-align:center;background:var(--card);transition:transform .3s}.facts li:hover{transform:translateY(-4px)}
.facts b{display:block;font-size:1.4rem;letter-spacing:-.03em}.facts span{color:var(--mute);font-size:.85rem}
.timeline{border-left:2px solid var(--text);padding-left:26px;max-width:820px}
.tl{position:relative}.tl::before{content:"";position:absolute;left:-36px;top:30px;width:14px;height:14px;border-radius:50%;background:var(--text)}
.tl-head{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;align-items:center}.tl-head h3{margin:0}
.org{font-weight:700;margin:6px 0}
.group h3{font-size:1.05rem}.group ul{margin:0;padding:0;list-style:none}
.group li{display:flex;gap:10px;align-items:center;padding:7px 0;color:var(--mute)}
.group li svg,.clist svg{width:20px;height:20px;flex:none;fill:none;stroke:var(--text);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.resume{display:grid;grid-template-columns:minmax(0,340px) 1fr;gap:40px;align-items:center}
.rimg{display:block;border:1px solid var(--text);border-radius:14px;overflow:hidden;box-shadow:0 24px 40px -18px rgba(0,0,0,.3);background:#fff;transition:transform .4s}
.rimg:hover{transform:scale(1.03)}.rimg img{display:block;width:100%;height:auto}.resume p{color:var(--mute);max-width:52ch}
.contact{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.clist{list-style:none;padding:0;margin:18px 0 0}.clist li{display:flex;gap:12px;align-items:center;padding:6px 0;color:var(--mute)}.clist .todo{opacity:.7;font-style:italic}
label{display:block;font-size:.85rem;color:var(--mute);margin:12px 0 4px}
input,textarea{width:100%;padding:12px 14px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--text);font:inherit;transition:border-color .2s}
input:focus,textarea:focus{border-color:var(--text);outline:0}
form .btn{margin-top:16px}.note{font-size:.8rem;color:var(--mute);margin:12px 0 0}
.hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
.foot{border-top:1px solid var(--line);padding:30px 0;text-align:center;color:var(--mute);font-size:.9rem}.foot p{margin:.2em}
dialog{width:min(680px,92vw);max-height:86vh;overflow:auto;background:var(--card);color:var(--text);border:2px solid var(--text);border-radius:var(--r);padding:30px;animation:up .35s both}
dialog::backdrop{background:rgba(5,5,5,.55)}dialog h2{margin-top:0}dialog h4{margin:20px 0 6px}dialog p,dialog li{color:var(--mute)}
.close{position:absolute;right:14px;top:10px;background:none;border:0;color:var(--text);font-size:2rem;cursor:pointer}
.warn{border-left:3px solid var(--text);padding:8px 14px;background:var(--alt);border-radius:6px}
.js .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s,transform .7s}.js .reveal.in{opacity:1;transform:none}
.js .reveal:not(.in) .grid>*{opacity:0}.reveal.in .grid>*{animation:up .7s cubic-bezier(.2,.7,.2,1) calc(var(--i,0)*90ms) both}

/* "hello" intro */
.intro{position:fixed;inset:0;z-index:200;display:none;place-items:center;cursor:pointer;background:var(--bg);transition:opacity .8s ease,transform .8s ease,visibility .8s;animation:introOut .8s ease 5s forwards}
.js .intro{display:grid}.intro.out{opacity:0;transform:scale(1.05);visibility:hidden;pointer-events:none}
.hello{display:inline-block;padding:.15em .3em;font:400 clamp(5.5rem,28vw,14rem)/1.2 "Great Vibes","Snell Roundhand","Brush Script MT","Segoe Script",cursive;background:var(--g);-webkit-background-clip:text;background-clip:text;color:transparent;
  -webkit-mask-image:linear-gradient(90deg,#000 45%,transparent 55%);mask-image:linear-gradient(90deg,#000 45%,transparent 55%);-webkit-mask-size:250% 100%;mask-size:250% 100%;-webkit-mask-position:100% 0;mask-position:100% 0;animation:write 2.3s cubic-bezier(.6,0,.35,1) .5s forwards}
@keyframes write{to{-webkit-mask-position:0 0;mask-position:0 0}}
.intro small{position:absolute;bottom:calc(28px + env(safe-area-inset-bottom,0px));color:var(--mute);font-size:.8rem;letter-spacing:.08em;opacity:0;animation:hint .6s ease 1.2s forwards}
@keyframes hint{to{opacity:.8}}@keyframes introOut{to{opacity:0;visibility:hidden;pointer-events:none}}

/* Responsive */
@media(max-width:940px){
  .contact,.resume{grid-template-columns:1fr}.rimg{max-width:340px}.burger{display:grid}
  #menu{position:absolute;top:64px;left:0;right:0;flex-direction:column;background:var(--bg);border-bottom:1px solid var(--line);padding:10px 20px;display:none}
  #menu.open{display:flex}#menu a::after{left:0;right:auto;width:40px}
}
@media(max-width:760px){
  .nav{transform:none;visibility:visible}
  .hero-page{--k:.9;--H:clamp(460px,125vw,640px);padding-top:92px;padding-bottom:44px}
  .hero-nav{display:none}.cut{height:86%}.hero-page{--HP:calc(var(--H) + 136px)}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}.js .reveal,.js .reveal:not(.in) .grid>*{opacity:1;transform:none}.js .intro{display:none}}

/* ===== Custom cursor: dot + trailing ring (mouse users only; white + difference blend works on any background) ===== */
.cur-dot,.cur-ring{position:fixed;left:0;top:0;pointer-events:none;z-index:9999;mix-blend-mode:difference;opacity:0;transition:opacity .25s}
.cur-dot{width:9px;height:9px;margin:-4.5px 0 0 -4.5px;border-radius:50%;background:#fff}
.cur-ring{width:38px;height:38px;margin:-19px 0 0 -19px}
.cur-ring::before{content:"";position:absolute;inset:0;border:1px solid #fff;border-radius:50%;transition:transform .25s}
.cur-ring.big::before{transform:scale(1.7)}
.cur-on .cur-dot,.cur-on .cur-ring{opacity:1}.cur-off .cur-dot,.cur-off .cur-ring{opacity:0}
.has-cursor,.has-cursor *{cursor:none}
.has-cursor input,.has-cursor textarea{cursor:text}
.has-cursor dialog,.has-cursor dialog *{cursor:auto}

/* ===== Skills: bordered grid, optional level bars ===== */
.skills{grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:6px;overflow:hidden}
.sk{background:var(--card);padding:26px 24px 22px;min-height:140px;display:flex;flex-direction:column;gap:4px;transition:background .3s}.sk:hover{background:var(--bg)}
.sk-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
.sk b{font-size:clamp(1.3rem,2.3vw,1.75rem);letter-spacing:-.04em;line-height:1.15;font-weight:900}
.sk em{font-style:normal;font-size:.72rem;letter-spacing:.14em;color:var(--mute)}
.sk span{color:var(--mute);font-size:.85rem;margin-bottom:18px}
.bar{display:block;height:2px;background:var(--line);margin-top:auto}
.bar u{display:block;height:100%;width:0;background:#B8975A;transition:width 1.3s cubic-bezier(.2,.7,.2,1) .25s}
.reveal.in .bar u{width:var(--w)}

/* ===== Page overlap: hero stays pinned, the next page slides up over it ===== */
.hero-page{--HP:calc(var(--H) + 2*max(44px,10vh));position:sticky;top:min(0px,calc(100vh - var(--HP)));z-index:0;transform-origin:50% 100%;transform:scale(calc(1 - var(--p,0)*.05));opacity:calc(1 - var(--p,0)*.55)}
.sheet{position:relative;z-index:2;background:var(--bg);border-radius:38px 38px 0 0;box-shadow:0 -26px 50px -22px rgba(0,0,0,.3)}
@media(prefers-reduced-motion:reduce){.hero-page{transform:none;opacity:1}}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<!-- INTRO: animated handwritten "hello". Change the word here if you like (also update the font link in <head>) -->
<div class="intro" id="intro" aria-hidden="true"><span class="hello">hello</span><small>Tap to skip</small></div>
<div class="progress" id="bar"></div>

<!-- NAVIGATION -->
<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a href="#home" class="logo" aria-label="Vasanth R, home">© Vasanth R</a>
    <button class="burger" id="burger" aria-label="Toggle menu" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>
    <nav id="menu" aria-label="Main">
      <a href="#home">Home</a><a href="#about">About</a><a href="#skills">Skills</a><a href="#projects">Projects</a><a href="#experience">Experience</a><a href="#education">Education</a><a href="#resume">Resume</a><a href="#contact">Contact</a>
    </nav>
