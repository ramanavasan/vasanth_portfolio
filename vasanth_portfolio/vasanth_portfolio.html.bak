<script>/* SETTINGS
   emailTo : every contact-form message is emailed to this address (free FormSubmit service).
             Leave "" to turn email delivery off.
   url + anonKey : OPTIONAL Supabase database that also stores messages for admin.html.
             The anon key is meant to be public; the database rules protect your data. */
window.DB = {
  emailTo: "Vasanthoffcl1@gmail.com",
  url: "",      // e.g. "https://abcdxyz.supabase.co"
  anonKey: ""   // "anon public" key from Supabase > Project Settings > API
};
</script>
<script>/* =====================================================
   EDIT YOUR CONTENT HERE: links, skills, projects, activities
   ===================================================== */

// 1) Social links. Paste your real URLs between the quotes (leave "" until ready).
const LINKS = {
  github: "https://github.com/Vasanthoffcl",
  linkedin: "",   // paste your LinkedIn profile URL, e.g. "https://www.linkedin.com/in/your-profile"
  instagram: "https://www.instagram.com/itz_vaxz_7"
};

// 2) Skills. To add one, copy a line and change the values.
//    icon options: code, layout, database, chart, cpu
//    level (optional): your own honest score from 0 to 100, e.g. level: 80 shows "80%" and a gold bar.
//    Leave level out and the skill shows just its name and tag.
const SKILLS = [
  { name: "Python",         icon: "code",     tag: "Programming" },
  { name: "HTML",           icon: "layout",   tag: "Web" },
  { name: "MySQL",          icon: "database", tag: "Databases" },
  { name: "Data Analytics", icon: "chart",    tag: "Analysis" },
  { name: "Data Science",   icon: "cpu",      tag: "Core focus" }
];

// 3) Projects. Put real URLs in github / demo ("" shows a clearly marked placeholder button).
//    sections: [heading, text] or [heading, [list items]]
const PROJECTS = [
  {
    title: "Smart Agriculture Monitoring & Decision Support System",
    icon: "leaf",
    short: "Developed a Smart Agriculture Monitoring & Decision Support System to monitor farmer, crop, weather, and agricultural data for better decision-making.",
    tech: [],   // add technologies once confirmed, e.g. ["Python", "MySQL"]
    github: "", demo: "",
    sections: [
      ["Project overview", "A practical application of data-driven technology to agriculture. The system brings together farmer, crop, weather, and agricultural data to support better decision-making."],
      ["Problem statement", "Farm-related information (farmers, crops, weather) can be scattered and hard to use together. This project explores how organizing and monitoring that data in one place can support clearer decisions."],
      ["Project objectives", ["Monitor farmer, crop, weather, and agricultural data", "Support better decision-making using organized data", "Apply data-driven technology to a practical agriculture problem"]],
      ["Technologies used", "To be added once confirmed."],
      ["Potential real-world applications", ["Monitoring farm and crop records", "Weather-aware farm planning", "Decision support for farmers and agricultural advisors"]]
    ],
    note: "The list of implemented features will be added once confirmed."
  },
  {
    title: "SpendDNA – Personal Finance Analytics",
    icon: "wallet",
    short: "Developed SpendDNA, a Python-based personal finance analytics system that cleans and categorizes six months of UPI/bank transactions to identify spending patterns and top vendors.",
    tech: ["Python"],
    github: "", demo: "",
    sections: [
      ["Project overview", "SpendDNA is a Python-based personal finance analytics system. It processes six months of UPI/bank transactions to reveal how money is spent."],
      ["Project objectives", ["Clean raw UPI/bank transaction data", "Categorize transactions", "Identify spending patterns", "Identify top vendors"]],
      ["Workflow", ["Load six months of UPI/bank transactions", "Clean the transaction data with Python", "Categorize each transaction", "Analyze spending patterns", "Identify top vendors"]],
      ["Potential real-world applications", ["Understanding personal spending habits", "Budget awareness for individuals", "Foundation for further personal finance analysis"]]
    ]
  }
];

// 4) Activities, strengths, interests
const ACTIVITIES = [
  { head: "Activities", icon: "calendar", items: ["Participant – HORIZON 25, KPR Institute of Engineering and Technology", "Participant – NOOB Hackfest, SRM IST Trichy", "Participant – ALGO-VERSE AI Workshop"] },
  { head: "Personal Strengths", icon: "zap", items: ["Versatile", "Adaptable", "Team player"] },
  { head: "Interests", icon: "target", items: ["Data Science", "Data Analytics", "Playing cricket", "Following cricket statistics"] }
];

/* =====================================================
   SITE CODE (you normally don't need to edit below)
   ===================================================== */
const ICONS = {
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  database: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5M3 12c0 1.7 4 3 9 3s9-1.3 9-3"/>',
  chart: '<path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/>',
  cpu: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3"/>',
  leaf: '<path d="M11 20A7 7 0 0 1 4 13c0-6 7-10 16-10 0 9-4 17-9 17z"/><path d="M4 21c2-6 5-9 9-11"/>',
  wallet: '<path d="M20 7H5a2 2 0 0 1 0-4h13v4z"/><path d="M3 5v14a2 2 0 0 0 2 2h15V7"/><circle cx="16" cy="14" r="1"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>',
  github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1-.5-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2.5 5 2.5c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9.5c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  zap: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/>',
  instagram: '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>'
};
const ic = n => `<svg viewBox="0 0 24 24" aria-hidden="true">${ICONS[n] || ""}</svg>`;
const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

// Skills
$("#skillGrid").innerHTML = SKILLS.map(s => {
  const lv = Number.isFinite(s.level) ? Math.max(0, Math.min(100, s.level)) : null;
  return `<div class="sk"><div class="sk-top"><b>${esc(s.name)}</b>${lv !== null ? `<em>${lv}%</em>` : ""}</div><span>${esc(s.tag || "")}</span>${lv !== null ? `<i class="bar"><u style="--w:${lv}%"></u></i>` : ""}</div>`;
}).join("");

// Link button (real link, or a clearly marked placeholder)
const linkBtn = (label, url) => url
  ? `<a class="btn ghost" href="${esc(url)}" target="_blank" rel="noopener">${label}</a>`
  : `<span class="btn ghost todo" title="Add your URL in script.js">${label} (add link)</span>`;

// Projects
$("#projectGrid").innerHTML = PROJECTS.map((p, i) => `
  <article class="card pcard">
    <div class="icon">${ic(p.icon)}</div>
    <h3>${esc(p.title)}</h3>
    <p>${esc(p.short)}</p>
    ${p.tech.length ? `<ul class="tags">${p.tech.map(t => `<li>${esc(t)}</li>`).join("")}</ul>` : ""}
    <button class="btn primary" data-i="${i}">Project Details</button>
  </article>`).join("");

// Activities
$("#activityGrid").innerHTML = ACTIVITIES.map(g => `
  <div class="card group"><h3>${esc(g.head)}</h3><ul>${g.items.map(t => `<li>${ic(g.icon)}<span>${esc(t)}</span></li>`).join("")}</ul></div>`).join("");

// Contact list
const row = (icon, label, url, text, fallback) => `<li>${ic(icon)}${url ? `<a href="${esc(url)}" ${url.startsWith("http") ? 'target="_blank" rel="noopener"' : ""}>${text}</a>` : `<span class="todo">${fallback || label + ": add your profile URL in script.js"}</span>`}</li>`;
$("#contactList").innerHTML =
  row("mail", "Email", "mailto:Vasanthoffcl1@gmail.com", "Vasanthoffcl1@gmail.com") +
  row("phone", "Phone", "tel:+919345383905", "+91-9345383905") +
  row("github", "GitHub", LINKS.github, "Vasanthoffcl") +
  row("linkedin", "LinkedIn", LINKS.linkedin, "Vasanth R", "LinkedIn: Vasanth R (add the profile link in script.js)") +
  row("instagram", "Instagram", LINKS.instagram, "@itz_vaxz_7");

// Project details popup
const modal = $("#modal");
$("#projectGrid").addEventListener("click", e => {
  const b = e.target.closest("button[data-i]"); if (!b) return;
  const p = PROJECTS[b.dataset.i];
  $("#mBody").innerHTML = `<h2 id="mTitle">${esc(p.title)}</h2>` +
    p.sections.map(([h, c]) => `<h4>${esc(h)}</h4>` + (Array.isArray(c) ? `<ul>${c.map(x => `<li>${esc(x)}</li>`).join("")}</ul>` : `<p>${esc(c)}</p>`)).join("") +
    (p.note ? `<p class="warn">${esc(p.note)}</p>` : "") +
    `<div class="btns">${linkBtn("GitHub", p.github)}${linkBtn("Live Demo", p.demo)}</div>`;
  modal.showModal();
});
$("#mClose").onclick = () => modal.close();
modal.addEventListener("click", e => { if (e.target === modal) modal.close(); });

// Mobile menu
const burger = $("#burger"), menu = $("#menu");
const navEl = $("#nav");
const updNav = () => navEl.classList.toggle("solid", scrollY > innerHeight * 0.55 || menu.classList.contains("open"));
const setMenu = open => { menu.classList.toggle("open", open); burger.setAttribute("aria-expanded", open); updNav(); };
addEventListener("scroll", updNav, { passive: true }); updNav();
burger.onclick = () => setMenu(!menu.classList.contains("open"));
menu.addEventListener("click", e => { if (e.target.tagName === "A") setMenu(false); });

// Highlight current section in nav + reveal on scroll
const links = [...menu.querySelectorAll("a")];
const spy = new IntersectionObserver(es => es.forEach(en => {
  if (en.isIntersecting) links.forEach(a => a.classList.toggle("on", a.getAttribute("href") === "#" + en.target.id));
}), { rootMargin: "-45% 0px -50% 0px" });
document.querySelectorAll("main section[id]").forEach(s => spy.observe(s));
const rev = new IntersectionObserver(es => es.forEach(en => { if (en.isIntersecting) { en.target.classList.add("in"); rev.unobserve(en.target); } }), { threshold: .12 });
document.querySelectorAll(".reveal").forEach(el => rev.observe(el));

// Contact form: emails the message to you (FormSubmit) and/or saves it to Supabase.
// With neither set in config.js it falls back to opening the visitor's email app.
const DBX = window.DB || {}, live = !!(DBX.url && DBX.anonKey), toMail = (DBX.emailTo || "").trim();
let lastSent = 0;
$("#formNote").textContent = (toMail || live) ? "Your message is sent straight to my inbox." : "This form has no server. It opens your email app with the message pre-filled; you press Send there.";
$("#form button").textContent = (toMail || live) ? "Send Message" : "Open in My Email App";
$("#form").addEventListener("submit", async e => {
  e.preventDefault();
  const f = e.target, note = $("#formNote"), btn = f.querySelector("button");
  if (f.website.value) return;   // hidden spam-trap field: real visitors never fill it
  if (!f.name.value.trim() || !f.email.validity.valid || !f.message.value.trim()) { note.textContent = "Please fill in your name, a valid email and a message."; return; }
  const data = { name: f.name.value.trim().slice(0, 100), email: f.email.value.trim().slice(0, 200), message: f.message.value.trim().slice(0, 2000) };
  if (!toMail && !live) {
    const body = data.message + "\n\nFrom: " + data.name + " (" + data.email + ")";
    location.href = "mailto:Vasanthoffcl1@gmail.com?subject=" + encodeURIComponent("Portfolio message from " + data.name) + "&body=" + encodeURIComponent(body);
    note.textContent = "Your email app should open with the message ready to send.";
    return;
  }
  if (Date.now() - lastSent < 30000) { note.textContent = "Please wait a few seconds before sending another message."; return; }
  btn.disabled = true; note.textContent = "Sending…";
  const jobs = [];
  if (toMail) jobs.push(fetch("https://formsubmit.co/ajax/" + toMail, { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" },
    body: JSON.stringify({ name: data.name, email: data.email, message: data.message, _subject: "Portfolio message from " + data.name, _template: "table", _captcha: "false" }) })
    .then(r => r.json().then(j => { if (!r.ok || String(j.success) === "false") throw new Error(j.message || "FormSubmit refused the message"); })));
  if (live) jobs.push(fetch(DBX.url + "/rest/v1/messages", { method: "POST", headers: { apikey: DBX.anonKey, Authorization: "Bearer " + DBX.anonKey, "Content-Type": "application/json", Prefer: "return=minimal" }, body: JSON.stringify(data) })
    .then(r => { if (!r.ok) throw 0; }));
  const res = await Promise.allSettled(jobs);
  if (res.some(x => x.status === "fulfilled")) { lastSent = Date.now(); f.reset(); note.textContent = "Thank you! Your message has been sent."; }
  else {
    console.warn("Contact form not sent:", res.map(x => x.reason));   // owner: press F12 > Console to see why
    note.textContent = location.protocol === "file:"
      ? "Sending only works on the live website, not from a file on your computer. Publish the site, then test again."
      : "Sorry, your message could not be sent right now. Please try again in a moment.";
  }
  btn.disabled = false;
});

$("#year").textContent = new Date().getFullYear();

/* =====================================================
   ANIMATIONS & EXTRAS (theme toggle, progress bar, typing, count-up)
   ===================================================== */
(() => {
  const root = document.documentElement;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Stagger index for cards (used by CSS animation delay)
  document.querySelectorAll(".grid").forEach(g => [...g.children].forEach((c, i) => c.style.setProperty("--i", i)));

  // Light / dark theme toggle (remembered in this browser)
  const tb = $("#theme"), mode = () => root.dataset.theme === "dark" ? "dark" : "light";
  const label = () => tb.setAttribute("aria-label", mode() === "dark" ? "Switch to light mode" : "Switch to dark mode");
  label();
  tb.onclick = () => {
    const t = mode() === "dark" ? "light" : "dark";
    root.dataset.theme = t;
    try { localStorage.setItem("theme", t); } catch (e) {}
    label();
  };

  // Scroll progress bar
  const bar = $("#bar");
  addEventListener("scroll", () => {
    const h = root.scrollHeight - innerHeight;
    bar.style.transform = "scaleX(" + (h > 0 ? scrollY / h : 0) + ")";
  }, { passive: true });

  // Typing effect cycles through your SKILLS list
  const el = $("#type"), words = SKILLS.map(s => s.name);
  if (still) el.textContent = words.join(", ");
  else {
    let w = 0, c = 0, del = false;
    (function tick() {
      const t = words[w];
      el.textContent = t.slice(0, c);
      if (!del && c === t.length) { del = true; return setTimeout(tick, 1400); }
      if (del && c === 0) { del = false; w = (w + 1) % words.length; }
      c += del ? -1 : 1;
      setTimeout(tick, del ? 45 : 90);
    })();
  }

  // Count-up for numbers marked data-count (the CGPA)
  const co = new IntersectionObserver(es => es.forEach(en => {
    if (!en.isIntersecting) return;
    co.unobserve(en.target);
    const end = parseFloat(en.target.dataset.count);
    if (still) return;
    const t0 = performance.now();
    (function step(t) {
      const p = Math.min((t - t0) / 1200, 1);
      en.target.textContent = (end * (1 - Math.pow(1 - p, 3))).toFixed(1);
      if (p < 1) requestAnimationFrame(step);
    })(t0);
  }));
  document.querySelectorAll("[data-count]").forEach(n => co.observe(n));
})();

// Hero social icons use the URLs from LINKS; until you add them they scroll to the Contact section
[["#sGit", LINKS.github], ["#sIn", LINKS.linkedin], ["#sIg", LINKS.instagram]].forEach(([id, url]) => {
  const a = $(id); if (!a) return;
  if (url) { a.href = url; a.target = "_blank"; a.rel = "noopener"; }
  else a.title = "Add your link in script.js";
});

/* =====================================================
   CUSTOM CURSOR (dot + trailing ring). Only for mouse users; off with reduced motion.
   To remove it: delete this block and the "Custom cursor" block at the end of style.css.
   ===================================================== */
(() => {
  if (!matchMedia("(hover: hover) and (pointer: fine)").matches || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  const dot = document.createElement("i"), ring = document.createElement("i"), root = document.documentElement;
  dot.className = "cur-dot"; ring.className = "cur-ring";
  [dot, ring].forEach(e => { e.setAttribute("aria-hidden", "true"); document.body.append(e); });
  root.classList.add("has-cursor");
  let x = 0, y = 0, rx = 0, ry = 0, raf = 0, seen = false;
  const tick = () => {
    rx += (x - rx) * .16; ry += (y - ry) * .16;
    ring.style.transform = "translate3d(" + rx + "px," + ry + "px,0)";
    raf = (Math.abs(x - rx) > .1 || Math.abs(y - ry) > .1) ? requestAnimationFrame(tick) : 0;
  };
  addEventListener("pointermove", e => {
    if (e.pointerType !== "mouse") return;
    x = e.clientX; y = e.clientY;
    dot.style.transform = "translate3d(" + x + "px," + y + "px,0)";
    if (!seen) { seen = true; rx = x; ry = y; }
    root.classList.add("cur-on");
    if (!raf) raf = requestAnimationFrame(tick);
  }, { passive: true });
  document.addEventListener("pointerover", e => {
    const t = e.target; if (!t.closest) return;
    ring.classList.toggle("big", !!t.closest("a,button,summary,[role=button]"));
    root.classList.toggle("cur-off", !!t.closest("input,textarea,dialog"));
  });
  document.addEventListener("mouseleave", () => root.classList.remove("cur-on"));
})();

// Hero fades back slightly while the next page slides over it
(() => {
  const hero = $("#home"); if (!hero) return;
  addEventListener("scroll", () => hero.style.setProperty("--p", Math.min(1, Math.max(0, scrollY / innerHeight)).toFixed(3)), { passive: true });
})();
</script>
</body>
</html>
